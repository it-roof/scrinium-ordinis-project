DATABASE_URL=postgresql://user:password@host:5432/database
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional, empfohlen in Prod: eigener Schlüssel für SMTP-/Geheimnis-Verschlüsselung
# ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Transaktionsmail (Passwort-Reset usw.) — nicht User-SMTP
MAIL_HOST=smtp.beispiel.de
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Scrinium Ordinis <noreply@beispiel.de>"

# Öffentliche Desk-URL (Produktion). Lokal: http://localhost:3000
# Wichtig hinter Coolify: AUTH_URL muss mit der öffentlichen HTTPS-URL übereinstimmen
# (Cookie-Name Secure vs. non-Secure), sonst Redirect-Loop.
#
# LAN-Test (Handy/anderes Gerät): Entweder immer nur localhost ODER immer nur die
# LAN-IP nutzen — Cookies gelten pro Host. Für Abmelden/Redirects ggf. vorübergehend
# AUTH_URL=http://192.168.x.x:3000 setzen (gleiche Adresse wie im Browser).
AUTH_URL=https://app.scrinium-ordinis.de
AUTH_TRUST_HOST=true

# Maintenance mode: true = entire app shows /wartung
MAINTENANCE=false

# Local only: login with email only (no password). Always blocked when NODE_ENV=production.
AUTH_DEV_PASSWORDLESS=false

# Hetzner Object Storage (S3-compatible, private bucket)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=dr-schneiderbanger-orga-storage
S3_FORCE_PATH_STYLE=true
# Anhänge bei „Nachricht an Mitarbeiter“ laufen über den Server (kein Browser-CORS nötig).
# Optional für künftige Direkt-Uploads: CORS am Bucket (GET/PUT/HEAD, Content-Type).

# AWS Bedrock (Claude) — nur EU: Region eu-* und Model-ID eu.* (Code fail-closed)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# Dev only: KI-Debug unter /ai-debug — nur Tenant mit AI_DEBUG_TENANT_SLUG. Nie in Prod.
AI_DEBUG=false
# Required when AI_DEBUG=true: only this tenant slug (e.g. test-kanzlei). Not for platform admin.
AI_DEBUG_TENANT_SLUG=
# Pseudonym gate: block (default/Prod) = residuals must be marked/dismissed; warn = allow send with warning
AI_PSEUDONYM_GATE=block
