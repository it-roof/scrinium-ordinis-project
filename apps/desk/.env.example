DATABASE_URL=postgresql://user:password@host:5432/database
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Öffentliche Desk-URL (Produktion). Lokal: http://localhost:3000
AUTH_URL=https://app.scrinium-ordinis.de
AUTH_TRUST_HOST=true

# Maintenance mode: true = entire app shows /wartung
MAINTENANCE=false

# Hetzner Object Storage (S3-compatible, private bucket)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=dr-schneiderbanger-orga-storage
S3_FORCE_PATH_STYLE=true
